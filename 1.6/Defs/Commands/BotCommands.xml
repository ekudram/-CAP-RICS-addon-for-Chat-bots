    <permissionLevel>moderator</permissionLevel>
    <excludeFromPricelist>true</excludeFromPricelist>
    <cooldownSeconds>0</cooldownSeconds>
    <useCommandCooldown>false</useCommandCooldown>
  </CAP_ChatInteractive.ChatCommandDef>

