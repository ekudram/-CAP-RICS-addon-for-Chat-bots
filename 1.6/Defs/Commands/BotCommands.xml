<?xml version="1.0" encoding="utf-8" ?>
<!--
  Bot-only gamestate commands for RICS AI chatbot (Masie).
  Moderator permission keeps viewers from invoking them.
  excludeFromPricelist keeps them off the public RICS Pricelist site.
-->
<Defs>

  <CAP_ChatInteractive.ChatCommandDef>
    <defName>BotState</defName>
    <commandText>botstate</commandText>
    <label>bot state</label>
    <enabled>true</enabled>
    <commandClass>CAP_RICS_ChatbotAddon.Commands.BotStateCommand</commandClass>
    <commandDescription>AI bot only. Full colony gamestate snapshot as JSON (day, colonists, threat, food, medicine, weather, storyteller).</commandDescription>
    <permissionLevel>moderator</permissionLevel>
    <excludeFromPricelist>true</excludeFromPricelist>
    <cooldownSeconds>0</cooldownSeconds>
    <useCommandCooldown>false</useCommandCooldown>
  </CAP_ChatInteractive.ChatCommandDef>

  <CAP_ChatInteractive.ChatCommandDef>
    <defName>BotPawns</defName>
    <commandText>botpawns</commandText>
    <label>bot pawns</label>
    <enabled>true</enabled>
    <commandClass>CAP_RICS_ChatbotAddon.Commands.BotPawnsCommand</commandClass>
    <commandDescription>AI bot only. JSON list of free colonists (name, skills, health, mood, job).</commandDescription>
    <permissionLevel>moderator</permissionLevel>
    <excludeFromPricelist>true</excludeFromPricelist>
    <cooldownSeconds>0</cooldownSeconds>
    <useCommandCooldown>false</useCommandCooldown>
  </CAP_ChatInteractive.ChatCommandDef>

