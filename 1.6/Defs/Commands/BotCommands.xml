    <defName>BotWealth</defName>
    <commandText>botwealth</commandText>
    <label>bot wealth</label>
    <enabled>true</enabled>
    <commandClass>CAP_RICS_ChatbotAddon.Commands.BotWealthCommand</commandClass>
    <commandDescription>AI bot only. JSON wealth breakdown (total, items, buildings, pawns) and threat points.</commandDescription>
    <permissionLevel>moderator</permissionLevel>
    <excludeFromPricelist>true</excludeFromPricelist>
    <cooldownSeconds>0</cooldownSeconds>
    <useCommandCooldown>false</useCommandCooldown>
  </CAP_ChatInteractive.ChatCommandDef>

  <CAP_ChatInteractive.ChatCommandDef>
    <defName>BotResources</defName>
    <commandText>botresources</commandText>
    <label>bot resources</label>
    <enabled>true</enabled>
    <commandClass>CAP_RICS_ChatbotAddon.Commands.BotResourcesCommand</commandClass>
    <commandDescription>AI bot only. JSON stockpile counts (meals, medicine, materials, components).</commandDescription>
    <permissionLevel>moderator</permissionLevel>
